{
  "$schema": "https://schemas.wp.org/wp/7.1/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1440px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "slug": "ceredis-blue",
          "color": "#123B66",
          "name": "CEREDIS Blue"
        },
        {
          "slug": "ceredis-cyan",
          "color": "#12B8D6",
          "name": "CEREDIS Cyan"
        },
        {
          "slug": "ceredis-fuchsia",
          "color": "#D81B72",
          "name": "CEREDIS Fuchsia"
        },
        {
          "slug": "ceredis-ink",
          "color": "#172033",
          "name": "CEREDIS Ink"
        },
        {
          "slug": "ceredis-surface",
          "color": "#F4F7FA",
          "name": "CEREDIS Surface"
        },
        {
          "slug": "ceredis-border",
          "color": "#D9E2EC",
          "name": "CEREDIS Border"
        },
        {
          "slug": "ceredis-white",
          "color": "#FFFFFF",
          "name": "White"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "%",
        "vw",
        "vh"
      ],
      "spacingSizes": [
        {
          "slug": "xs",
          "size": "0.5rem",
          "name": "Extra small"
        },
        {
          "slug": "sm",
          "size": "0.75rem",
          "name": "Small"
        },
        {
          "slug": "md",
          "size": "1rem",
          "name": "Medium"
        },
        {
          "slug": "lg",
          "size": "1.5rem",
          "name": "Large"
        },
        {
          "slug": "xl",
          "size": "2.5rem",
          "name": "Extra large"
        },
        {
          "slug": "2xl",
          "size": "4rem",
          "name": "2X large"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
          "slug": "system",
          "name": "System"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "size": "0.875rem",
          "name": "Small"
        },
        {
          "slug": "body",
          "size": "1rem",
          "name": "Body"
        },
        {
          "slug": "lead",
          "size": "1.25rem",
          "name": "Lead"
        },
        {
          "slug": "eyebrow",
          "size": "0.75rem",
          "name": "Eyebrow"
        },
        {
          "slug": "site-title",
          "size": "1.5rem",
          "name": "Site title"
        },
        {
          "slug": "hero",
          "size": "clamp(2.75rem, 7vw, 6rem)",
          "name": "Hero"
        }
      ]
    },
    "border": {
      "radius": true
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|ceredis-white",
      "text": "var:preset|color|ceredis-ink"
    },
    "spacing": {
      "blockGap": "1.5rem"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|system",
      "fontSize": "var:preset|font-size|body",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontWeight": "700",
          "lineHeight": "1.15"
        }
      },
      "button": {
        "border": {
          "radius": "999px"
        },
        "typography": {
          "fontWeight": "600"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|ceredis-blue"
        }
      }
    }
  }
}
