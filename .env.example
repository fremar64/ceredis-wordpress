WP_DEBUG=true
SCRIPT_DEBUG=true
WP_MULTISITE=false
CEREDIS_ADMIN_USER=ceredis-admin
CEREDIS_ADMIN_EMAIL=admin@ceredis.test

# Generate eight unique values; do not reuse production credentials.
