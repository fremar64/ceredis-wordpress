{
  "$schema": "https://schemas.wp.org/wp/7.1/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1320px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "slug": "ceredis-blue",
          "color": "#123B66",
          "name": "CEREDIS Blue"
        },
        {
          "slug": "ceredis-cyan",
          "color": "#12B8D6",
          "name": "CEREDIS Cyan"
        },
        {
          "slug": "ceredis-fuchsia",
          "color": "#D81B72",
          "name": "CEREDIS Fuchsia"
        },
        {
          "slug": "ceredis-fuchsia-hover",
          "color": "#A3114D",
          "name": "CEREDIS Fuchsia Hover"
        },
        {
          "slug": "ceredis-deep",
          "color": "#0B2A4A",
          "name": "CEREDIS Deep Navy"
        },
        {
          "slug": "ceredis-pale-cyan",
          "color": "#E8F6FA",
          "name": "CEREDIS Pale Cyan"
        },
        {
          "slug": "ceredis-pale-fuchsia",
          "color": "#FBE7F0",
          "name": "CEREDIS Pale Fuchsia"
        },
        {
          "slug": "ceredis-ink",
          "color": "#172033",
          "name": "CEREDIS Ink"
        },
        {
          "slug": "ceredis-surface",
          "color": "#F4F7FA",
          "name": "CEREDIS Surface"
        },
        {
          "slug": "ceredis-border",
          "color": "#D9E2EC",
          "name": "CEREDIS Border"
        },
        {
          "slug": "ceredis-white",
          "color": "#FFFFFF",
          "name": "White"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "%",
        "vw",
        "vh"
      ],
      "spacingSizes": [
        {
          "slug": "xs",
          "size": "0.5rem",
          "name": "Extra small"
        },
        {
          "slug": "sm",
          "size": "0.75rem",
          "name": "Small"
        },
        {
          "slug": "md",
          "size": "1rem",
          "name": "Medium"
        },
        {
          "slug": "lg",
          "size": "1.5rem",
          "name": "Large"
        },
        {
          "slug": "xl",
          "size": "2.5rem",
          "name": "Extra large"
        },
        {
          "slug": "2xl",
          "size": "4rem",
          "name": "2X large"
        },
        {
          "slug": "3xl",
          "size": "6rem",
          "name": "3X large"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
          "slug": "system",
          "name": "System"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "size": "0.875rem",
          "name": "Small"
        },
        {
          "slug": "body",
          "size": "1rem",
          "name": "Body"
        },
        {
          "slug": "lead",
          "size": "1.25rem",
          "name": "Lead"
        },
        {
          "slug": "eyebrow",
          "size": "0.875rem",
          "name": "Eyebrow"
        },
        {
          "slug": "site-title",
          "size": "1.5rem",
          "name": "Site title"
        },
        {
          "slug": "hero",
          "size": "clamp(2.5rem, 4.5vw, 4.5rem)",
          "name": "Hero"
        },
        {
          "slug": "heading-2",
          "size": "clamp(2rem, 3.5vw, 3rem)",
          "name": "Heading 2"
        },
        {
          "slug": "heading-3",
          "size": "clamp(1.25rem, 2vw, 1.5rem)",
          "name": "Heading 3"
        },
        {
          "slug": "stat",
          "size": "clamp(2.5rem, 4vw, 3.5rem)",
          "name": "Statistic"
        }
      ]
    },
    "border": {
      "radius": true
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|ceredis-white",
      "text": "var:preset|color|ceredis-ink"
    },
    "spacing": {
      "blockGap": "1.5rem"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|system",
      "fontSize": "var:preset|font-size|body",
      "lineHeight": "1.7"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontWeight": "700",
          "lineHeight": "1.15"
        },
        "color": {
          "text": "var:preset|color|ceredis-ink"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|heading-2"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|heading-3"
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|ceredis-blue",
          "text": "var:preset|color|ceredis-white"
        },
        "border": {
          "radius": "999px"
        },
        "typography": {
          "fontWeight": "600"
        },
        "spacing": {
          "padding": {
            "top": "0.85rem",
            "right": "1.5rem",
            "bottom": "0.85rem",
            "left": "1.5rem"
          }
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|ceredis-blue"
        }
      }
    }
  }
}
